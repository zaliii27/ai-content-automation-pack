    {
      "parameters": {
        "jsCode": "// Three ways in: a button tap from Telegram, the weekly timer, or the API.\nconst input = $input.first().json;\nconst cfg = input.cfg || {};\nconst fromApi = input.body !== undefined && input.headers !== undefined;\n\nlet action = 'report';                       // the weekly timer lands here\nlet content_id = '';\nlet chat_id = String(cfg.owner_chat_id || '');\nlet callback_id = '';\n\nif (fromApi) {\n  action = String(input.body?.action || 'report').toLowerCase();\n  content_id = String(input.body?.content_id || '').toUpperCase();\n  chat_id = String(input.body?.chat_id || chat_id);\n} else if (input.callback) {\n  const [a, id = ''] = String(input.callback.data).split(':');\n  action = a.toLowerCase();\n  content_id = id.toUpperCase();\n  chat_id = String(input.chat_id);\n  callback_id = input.callback.id;\n} else if (input.route) {\n  chat_id = String(input.chat_id);           // the owner typed /report\n}\n\nif (!['approve', 'redo', 'report'].includes(action)) throw new Error(`I don't know the action \"${action}\".`);\nif (action !== 'report' && !/^AD-[A-Z0-9]{3,12}$/.test(content_id)) throw new Error('That button has no valid ad code.');\n\nreturn [{ json: { action, content_id, chat_id, callback_id, cfg } }];"
      },
