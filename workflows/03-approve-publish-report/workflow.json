    {
      "parameters": {
        "jsCode": "// Looks the ad up in the calendar, or builds the weekly report.\nconst act = $('Resolve Action').first().json;\nconst cfg = act.cfg || {};\nconst rows = $input.all().map(i => i.json).filter(r => r && r.content_id && r.status !== undefined);\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst status = r => String(r.status || '').toUpperCase();\nconst base = {\n  action: act.action,\n  chat_id: act.chat_id,\n  publish_chat_id: String(cfg.publish_chat_id || ''),\n  worker_url: String(cfg.worker_url || '').replace(/\\/+$/, ''),\n  stamp: $now.toFormat('yyyy-MM-dd HH:mm'),\n};\n\nif (act.action === 'report') {\n  const parseDate = value => {\n    const s = String(value || '').trim();\n    for (const f of ['yyyy-MM-dd HH:mm', 'yyyy-MM-dd HH:mm:ss', 'M/d/yyyy H:mm:ss', 'M/d/yyyy H:mm']) {\n      const d = DateTime.fromFormat(s, f, { zone: 'Asia/Manila' });\n      if (d.isValid) return d;\n    }\n    const iso = DateTime.fromISO(s, { zone: 'Asia/Manila' });\n    return iso.isValid ? iso : null;\n  };\n  const since = $now.minus({ days: 7 });\n  const recent = rows.filter(r => { const d = parseDate(r.created_at); return d && d >= since; });\n  const count = list => recent.filter(r => list.includes(status(r))).length;\n  const scripted = recent.length;\n  const rendered = count(['READY', 'APPROVED', 'POSTED']);\n  const approved = count(['APPROVED', 'POSTED']);\n  const posted = count(['POSTED']);\n  const waiting = rows.filter(r => ['SCRIPTED', 'CLIPS', 'REDO', 'READY'].includes(status(r))).slice(-8);\n\n  const text = [\n    `📊 <b>Weekly content report</b> · ${since.toFormat('MMM d')} to ${$now.toFormat('MMM d')}`,\n    `<b>${esc(cfg.brand_name)}</b>`,\n    '',\n    `✍️ Scripts written: <b>${scripted}</b>`,\n    `🎞 Ads rendered: <b>${rendered}</b>`,\n    `✅ Approved: <b>${approved}</b>`,\n    `📣 Posted: <b>${posted}</b>`,\n    scripted ? `\\nFrom script to approved ad: <b>${Math.round(approved / scripted * 100)}%</b>` : '\\nNo new scripts this week. Send /ad to start one.',\n    ...(waiting.length ? ['', '<b>Waiting on you</b>', ...waiting.map(r =>\n      `• <code>${esc(r.content_id)}</code> ${esc(r.product)}: ${status(r) === 'READY' ? 'needs your approval' : 'needs clips'}`)] : []),\n  ].join('\\n');\n  return [{ json: { ...base, text } }];\n}\n\nconst row = rows.find(r => String(r.content_id).toUpperCase() === act.content_id);\nif (!row) throw new Error(`I can't find ${act.content_id} in the content calendar.`);\nconst post_text = (String(row.caption || '') + '\\n\\n' + String(row.hashtags || '')).trim().slice(0, 1000);\nreturn [{ json: {\n  ...base,\n  content_id: act.content_id,\n  product: String(row.product || ''),\n  post_text,\n  post_html: esc(post_text),\n} }];"
      },
