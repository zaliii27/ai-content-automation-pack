          "value": "Calendar"
        },
        "options": {}
      },
      "id": "95a05e95-83bc-547c-84c1-0ff50d3abd1d",
      "name": "Read Calendar",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        420
      ],
      "credentials": {
        "googleApi": {
          "id": "SprintGSheets001",
          "name": "Content Calendar (Google service account)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Finds the ad in the content calendar: the code the owner gave, or else the newest ad still in progress.\nconst job = $('Resolve Job').first().json;\nconst cfg = job.cfg || {};\nconst rows = $input.all().map(i => i.json).filter(r => r && r.content_id && r.status !== undefined);\nconst status = r => String(r.status || '').toUpperCase();\n\nlet row = null;\nif (job.wanted_id) {\n  row = rows.find(r => String(r.content_id).toUpperCase() === job.wanted_id) || null;\n} else {\n  row = [...rows].reverse().find(r => ['SCRIPTED', 'CLIPS', 'REDO', 'READY'].includes(status(r))) || null;\n}\nif (!row && !(job.from_api && job.wanted_id)) {\n  throw new Error(job.wanted_id\n    ? `I can't find ${job.wanted_id} in the content calendar. Check the code, or send /ad to start a new one.`\n    : 'There is no ad waiting for clips. Send /ad first to get a script.');\n}\n\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst o = job.overrides || {};\nconst content_id = String(row?.content_id || job.wanted_id).toUpperCase();\nconst texts = Array.isArray(o.texts) && o.texts.length\n  ? o.texts.map(String)\n  : [row?.scene1_text, row?.scene2_text, row?.scene3_text].map(t => String(t || ''));\nconst caption = String(row?.caption || '');\nconst hashtags = String(row?.hashtags || '');\n\nreturn [{ json: {\n  route: job.too_big ? 'too_big' : job.mode,\n  content_id,\n  chat_id: job.chat_id,\n  message_id: job.message_id,\n  video: job.video,\n  product: String(row?.product || ''),\n  caption_html: esc((caption + '\\n' + hashtags).trim().slice(0, 700)),\n  worker_url: String(cfg.worker_url || '').replace(/\\/+$/, ''),\n  clips_needed: 3,\n  render_request: {\n    content_id,\n    texts,\n    brand: o.brand || cfg.brand_name,\n    cta: o.cta || cfg.brand_cta,\n    brand_color: cfg.brand_color,\n  },\n} }];"
      },
