    {
      "parameters": {
        "jsCode": "// Works out what the owner wants: store a clip, render now, or run the demo.\nconst input = $input.first().json;\nconst cfg = input.cfg || {};\nconst fromApi = input.body !== undefined && input.headers !== undefined;\nconst src = fromApi ? (input.body || {}) : input;\n\n// An ad code such as AD-7KQ2M can be given in the video caption or after the command.\nconst idText = fromApi ? String(src.content_id || '') : String(src.text || '');\nconst idMatch = idText.toUpperCase().match(/AD-[A-Z0-9]{3,12}/);\n\nlet mode = 'render';\nif (fromApi) mode = ['clip', 'demo', 'render'].includes(src.mode) ? src.mode : 'render';\nelse if (src.video) mode = 'clip';\nelse if (src.command === 'demo') mode = 'demo';\n\nconst video = src.video || null;\nreturn [{ json: {\n  mode,\n  from_api: fromApi,\n  wanted_id: idMatch ? idMatch[0] : '',\n  chat_id: String(src.chat_id || cfg.owner_chat_id || ''),\n  message_id: src.message_id || 0,\n  video,\n  too_big: !!(video && video.file_size > 20 * 1024 * 1024),   // Telegram bots can download 20 MB at most\n  overrides: fromApi ? { texts: src.texts, brand: src.brand, cta: src.cta } : {},\n  cfg,\n} }];"
      },
      "id": "f8c8c681-d213-594c-8b48-7f22c82b408a",
      "name": "Resolve Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        420
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "sheet",
        "operation": "read",
        "documentId": {
