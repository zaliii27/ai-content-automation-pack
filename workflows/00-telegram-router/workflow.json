    {
      "parameters": {
        "jsCode": "// Turns one raw Telegram update into a small, tidy item and decides where it goes.\nconst raw = $input.first().json;\nconst cfg = raw.cfg || {};\nconst u = (raw.body && raw.headers) ? raw.body : raw;\n\nconst owner = String(cfg.owner_chat_id || '').trim();\nconst msg = u.message || null;\nconst cb = u.callback_query || null;\nconst chatId = String((cb ? cb.message?.chat?.id : msg?.chat?.id) ?? '');\nconst fromName = (cb ? cb.from : msg?.from)?.first_name || 'there';\nconst text = String(msg?.text || msg?.caption || '').trim();\nconst doc = msg?.document;\nconst video = msg?.video || (doc && /^video\\//.test(doc.mime_type || '') ? doc : null);\nconst command = ((text.match(/^\\/([a-z]+)/i) || [])[1] || '').toLowerCase();\n\nlet route = 'unknown';\nif (!chatId) route = 'ignore';\nelse if (owner && chatId !== owner) route = 'blocked';      // only the owner may use the bot\nelse if (cb) route = 'action';\nelse if (video) route = 'clip';\nelse if (command === 'start' || command === 'help') route = 'help';\nelse if (command === 'ad') route = 'ad';\nelse if (command === 'render' || command === 'demo') route = 'clip';\nelse if (command === 'report') route = 'action';\n\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst help_text = [\n  `👋 Hi ${esc(fromName)}! I'm the AI Content Studio for <b>${esc(cfg.brand_name)}</b>.`,\n  '',\n  '<b>1. Get an ad script</b>',\n  '/ad Product | key benefit | audience | language',\n  '<i>Example (tap to copy):</i>',\n  '<code>/ad Vanilla Oat Cold Brew | smooth, never bitter, 120mg caffeine | students and remote workers | English</code>',\n  '',\n  '<b>2. Send me your clips</b>',\n  'Make the 3 scenes in Google Flow, then send the 3 videos here in order. I add captions and an end card and send back the finished ad.',\n  'No clips yet? <code>/demo</code> builds it with placeholder clips.',\n  '',\n  '<b>3. Approve</b>',\n  'Tap ✅ Approve and I give you the caption and hashtags, ready to post.',\n  '',\n  '/report shows this week\\'s numbers.',\n  '',\n  `Your chat ID: <code>${esc(chatId)}</code>`,\n  owner ? '' : '⚙️ <i>Setup tip: put this chat ID in the .env file as OWNER_CHAT_ID so only you can use this bot.</i>',\n].join('\\n').trim();\n\nreturn [{ json: {\n  route,\n  chat_id: chatId,\n  from_name: fromName,\n  text,\n  command,\n  args: text.replace(/^\\/[a-z]+(@\\w+)?\\s*/i, ''),\n  message_id: msg?.message_id || cb?.message?.message_id || 0,\n  video: video ? {\n    file_id: video.file_id,\n    file_name: video.file_name || 'clip.mp4',\n    file_size: video.file_size || 0,\n  } : null,\n  callback: cb ? { id: cb.id, data: cb.data || '' } : null,\n  help_text,\n} }];"
      },
