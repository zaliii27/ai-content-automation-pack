  "id": "SprintRouter0000",
  "name": "00 Telegram Router (Content Studio Bot)",
  "nodes": [
    {
      "parameters": {
        "content": "## 00 · Telegram Router\nOne Telegram bot can only talk to **one** trigger, so every message enters here and is passed on:\n\n- `/ad ...` → **01 Ad Brief to Script Pack**\n- a video, `/render`, `/demo` → **02 Clips to Finished Ad**\n- a button tap, `/report` → **03 Approve, Publish and Report**\n- `/start`, `/help` → help message\n\nIf `OWNER_CHAT_ID` is set in `.env`, messages from anyone else are ignored.",
        "height": 300,
        "width": 560,
        "color": 4
      },
      "id": "9b4d4a58-cff5-50c7-821e-ce72f954320c",
      "name": "Note 0",
