# Copy this file to ".env" and change the values there.
# ".env" is ignored by git, so nothing in it reaches GitHub.
#
# Secret keys (Telegram bot token, Google key, AI key) do NOT go here.
# They go into n8n's Credentials screen, which stores them encrypted.
# After changing this file, run start.ps1 again so n8n picks up the changes.

# n8n version to run (pinned so the project keeps working the same way).
N8N_VERSION=2.37.7

# Public HTTPS address of this n8n. start.ps1 fills this in. Do not edit by hand.
WEBHOOK_URL=http://localhost:5679/

# ---- AI model that writes the scripts (any OpenAI-compatible endpoint) ----
# Default: Ollama on this laptop. Free, private, lower quality.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
# Skips the model's slow "thinking" step. Leave empty if your model rejects it.
LLM_REASONING_EFFORT=none
# For Google Gemini instead, use these three lines and put "Bearer <your key>" in the
# n8n credential "LLM API key (Bearer header)". Google retires model names over time:
# if you get "no longer available", the error message names the replacement.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_REASONING_EFFORT=low

# ---- Google Sheets content calendar ----
# The long ID in the sheet's address: docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_ID=

# ---- Telegram ----
# Your own chat ID. Send /start to the bot and it tells you the number.
# When set, the bot ignores everyone else.
OWNER_CHAT_ID=
# Optional: a channel or group where approved ads are posted automatically
# (add the bot there as an admin). Leave empty to get a copy-paste posting kit instead.
PUBLISH_CHAT_ID=

# ---- The brand the ads are for ----
BRAND_NAME=Tala Coffee Co.
BRAND_VOICE=warm, playful, confident
BRAND_CTA=Order today. Link in bio.
# Background color of the end card.
BRAND_COLOR=#1F3A2E
